#!/usr/bin/env bash

selected_location_file="$HOME/.cache/polybar/weather-selected-location"
config_file="$HOME/.cache/polybar/weather-config"
cache_file="$HOME/.cache/polybar/weather-cache"

get_temp_from_cache() {
    local name="$1"
    local current_temp
    local location

    while IFS='|' read -r location current_temp _ _; do
        if [[ "$name" == "$location" ]]; then
            if [[ -n "$current_temp" ]]; then
                printf "%s" "$current_temp"
            else
                echo "--"
            fi
        fi
    done <"$cache_file"
}

while IFS='|' read -r location _; do
    if [[ "$location" == "Home" ]]; then
        default_location="$location"
    fi
done <"$config_file"

if [[ -z "$default_location" ]]; then
    echo "--"
    exit 0
fi

if [[ -s "$selected_location_file" ]]; then
    IFS= read -r location <"$selected_location_file"
fi

while IFS='|' read -r name temp _; do
    if [[ "$name" == "$location" ]]; then
        current_temp="$temp"
        break
    fi
done <"$cache_file"

if [[ -n "$current_temp" ]]; then
    printf "%s" "$current_temp"
else
    echo "--"
fi
