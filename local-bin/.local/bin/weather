#!/usr/bin/env bash

station_file="$HOME/.cache/polybar/weather-stations"
locations_file="$HOME/.cache/polybar/weather-locations"
weather_cache="$HOME/.cache/polybar/weather-cache"

get_temp_from_cache() {
    local name="$1"
    local current_temp
    local location

    while IFS='|' read -r location current_temp _ _; do
        if [[ "$name" == "$location" ]]; then
            if [[ -n "$current_temp" ]]; then
                printf "%s" "$current_temp"
            else
                echo "--"
            fi
        fi
    done <"$weather_cache"
}

default_location="$(
    awk -F'|' '$1 == "Home" {print $1; exit}' "$locations_file"
)"

if [[ -z "$default_location" ]]; then
    echo "--"
    exit 0
fi

if [[ -s "$station_file" ]]; then
    IFS= read -r location <"$station_file"
fi

while IFS='|' read -r name temp _; do
    if [[ "$name" == "$location" ]]; then
        current_temp="$temp" && break
    fi
done <"$weather_cache"

if [[ -n "$current_temp" ]]; then
    printf "%s" "$current_temp"
else
    echo "--"
fi
