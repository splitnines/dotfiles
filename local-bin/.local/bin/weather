#!/usr/bin/env bash

FIELD='"\(.current.temperature_2m // "--")"'
station_file="$HOME/.cache/polybar/weather-stations"
location_file="$HOME/.cache/polybar/weather-locations"

default_coords="$(
  awk -F'|' '$1 == "Home" {print $2; exit}' "$location_file"
)"

if [[ -z "$default_coords" ]]; then
  echo "--"
  exit 0
fi

IFS=',' read -r latitude longitude <<<"$default_coords"

if [[ -s "$station_file" ]]; then
  IFS=',' read -r latitude longitude <"$station_file"
fi

if [[ -n "$latitude" && -n "$longitude" ]]; then
  url="https://api.open-meteo.com/v1/forecast\
?latitude=${latitude}\
&longitude=${longitude}\
&current=temperature_2m\
&temperature_unit=fahrenheit\
&timezone=America%2FLos_Angeles"
fi

current_temp=$(curl -sf "${url:-}" | jq -r "$FIELD")

if [[ -n "$current_temp" ]]; then
  printf "%.0f%s" "$current_temp" "°F"
else
  echo "--"
fi
