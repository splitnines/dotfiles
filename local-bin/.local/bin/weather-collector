#!/usr/bin/env bash

# This script is run from crontab and collects the temperature
# for the coordinates listed in $HOME/.cache/polybar/weather-config
# and write the temperature to $HOME/.cache/polybar/weather-cache
#
# Dependencies: curl, jq

FIELDS='"\(.current.temperature_2m // "--")|\(.daily.temperature_2m_min[0] // "--")|\(.daily.temperature_2m_max[0] // "--")"'
config_file="$HOME/.cache/polybar/weather-config"
cache_file="$HOME/.cache/polybar/weather-cache"

# Pull the temperature from the API
# return temperature
get_temp() {
    local latitude
    local longitude
    local readings

    latitude="$1"
    longitude="$2"

    url="https://api.open-meteo.com/v1/forecast\
?latitude=${latitude}\
&longitude=${longitude}\
&daily=temperature_2m_max,temperature_2m_min\
&current=temperature_2m\
&temperature_unit=fahrenheit\
&timezone=America%2FLos_Angeles"

    readings=$(curl -sf "${url:-}" | jq -r "$FIELDS")

    if [[ -n $readings ]]; then
        IFS="|" read -r current_temp daily_min daily_max <<<"$readings"
        printf '%.0f%s|%.0f%s|%.0f%s' \
            "$current_temp" "°F" "$daily_min" "°F" "$daily_max" "°F"
    else
        echo "--|--|--"
    fi
}

# Write the location name, temperature and coordinates to cache file
while IFS='|' read -r name coords; do
    if [[ -z $name || -z $coords ]]; then
        continue
    fi

    IFS=',' read -r latitude longitude <<<"$coords"

    temps="$(get_temp "$latitude" "$longitude")"
    printf "%s|%s\n" "$name" "$temps"
done <"$config_file" >"$cache_file"
