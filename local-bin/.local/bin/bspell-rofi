#!/usr/bin/env bash

error() {
    local msg=$1
    local date_time

    date_time=$(date '+%b %d  %T.%3N')
    printf '%s: %s\n' "$date_time" "$msg" >&2
    notify-send -t 5000 -u critical "$date_time: $msg"
    exit 1
}

require_cmd() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || {
            error "%COMMAND-3-ERROR: required command not found: $cmd"
        }
    done
}

require_cmd aspell rofi xclip

word=$(
    rofi -dmenu -p 'spelling' \
        -theme-str 'window { width: 22%; height: 5%; }' </dev/null
) || exit 1
[[ -n $word ]] || exit

suggestions=()
while IFS= read -r line; do
    case $line in
    '& '*)
        remaining=${line#*: }
        while [[ $remaining == *', '* ]]; do
            suggestions+=("${remaining%%, *}")
            remaining=${remaining#*, }
        done
        suggestions+=("$remaining")
        ;;
    '*')
        exit 0
        ;;
    esac
done < <(printf '%s\n' "$word" | aspell -a --sug-mode=bad-spellers)

printf '%s\n' "${suggestions[@]}" |
    rofi -dmenu -p 'suggestions' \
        -theme-str 'window { width: 20%; height: 20%; }' |
    xclip -selection clipboard -rmlastnl
