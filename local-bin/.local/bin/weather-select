#!/usr/bin/env bash

locations_file="$HOME/.cache/polybar/weather-locations"
station_file="$HOME/.cache/polybar/weather-stations"
weather_cache="$HOME/.cache/polybar/weather-cache"

get_temp_from_cache() {
  local name="$1"
  local current_temp
  local location

  while IFS='|' read -r location current_temp _; do
    if [[ "$name" == "$location" ]]; then
      if [[ -n "$current_temp" ]]; then
        printf "%s" "$current_temp"
      else
        echo "--"
      fi
    fi
  done <"$weather_cache"
}

# Example: Sacramento|67°F|38.5816,-121.4944
menu="$(
  while IFS='|' read -r name coords; do
    [[ -z "$name" ]] && continue
    [[ -z "$coords" ]] && continue

    temp="$(get_temp_from_cache "$name")"
    printf "%s|%s|%s\n" "$name" "$temp" "$coords"
  done <"$locations_file"
)"

choice="$(
  printf "%s\n" "$menu" |
    awk -F'|' '{printf "%-20s %s\n", $1, $2}' |
    rofi -dmenu -p "Weather"
)"

[[ -z "$choice" ]] && exit 0

selected_location="$(printf "%s\n" "$choice" | awk '{print $1}')"

[[ -z "$selected_location" ]] && exit 1

# echo "$selected_location" >"$station_file"

(
  flock -x 200
  printf "%s\n" "$selected_location" >"$station_file"
) 200>"${station_file}.lock"

polybar-msg cmd restart >/dev/null 2>&1
