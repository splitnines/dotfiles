#!/usr/bin/env bash

FIELD='"\(.current.temperature_2m // "--")"'
locations_file="$HOME/.cache/polybar/weather-locations"
station_file="$HOME/.cache/polybar/weather-stations"

get_temp() {
  local latitude="$1"
  local longitude="$2"

  url="https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=temperature_2m&temperature_unit=fahrenheit&timezone=America%2FLos_Angeles"

  current_temp=$(curl -sf "${url:-}" | jq -r "$FIELD")

  printf "%.0f%s" "$current_temp" "°F"
}

menu="$(
  while IFS='|' read -r name coords; do
    [ -z "$name" ] && continue
    [ -z "$coords" ] && continue

    IFS=',' read -r latitude longitude <<<"$coords"

    temp="$(get_temp "$latitude" "$longitude")"
    printf "%s|%s|%s\n" "$name" "$temp" "$coords"
  done <"$locations_file"
)"

choice="$(
  printf "%s\n" "$menu" |
    awk -F'|' '{printf "%-20s %s\n", $1, $2}' |
    rofi -dmenu -p "Weather"
)"

[[ -z "$choice" ]] && exit 0

selected_location="$(printf "%s\n" "$choice" | awk '{print $1}')"

selected_coords="$(
  printf "%s\n" "$menu" |
    awk -F'|' -v name="$selected_location" '$1 == name {print $3; exit}'
)"

echo "$menu"

[ -z "$selected_coords" ] && exit 1

echo "$selected_coords" >"$station_file"

polybar-msg cmd restart >/dev/null 2>&1
