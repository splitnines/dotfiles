#!/usr/bin/env bash

error() {
    local msg=$1
    local date_time

    date_time=$(date '+%b %d  %T.%3N')
    printf '%s: %s\n' "$date_time" "$msg" >&2
    notify-send -t 5000 -u critical "$date_time: $msg"
    exit 1
}

require_cmd() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || {
            error "%COMMAND-3-ERROR: required command not found: $cmd"
        }
    done
}

require_cmd aspell fzf xclip

(
    word=${1:-}
    if [[ -z $word ]]; then
        read -r -p 'Lookup: ' word </dev/tty || exit
        [[ -n $word ]] || exit
    fi

    choice=$(
        printf '%s\n' "$word" | aspell -a |
            while IFS= read -r line; do
                case $line in
                '& '* | '? '*)
                    suggestions=${line#*: }
                    while [[ $suggestions == *', '* ]]; do
                        printf '%s\n' "${suggestions%%, *}"
                        suggestions=${suggestions#*, }
                    done
                    printf '%s\n' "$suggestions"
                    ;;
                esac
            done | fzf --prompt="Selection > " --popup
    ) || exit

    [[ -n $choice ]] || exit
    printf '%s' "$choice" | xclip -selection clipboard
)
