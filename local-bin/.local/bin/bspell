#!/usr/bin/env bash

require_cmd() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || {
            echo "required command not found: $cmd"
            exit 1
        }
    done
}

require_cmd aspell fzf xclip

word=${1:-}
if [[ -z $word ]]; then
    read -r -p 'lookup: ' word </dev/tty || exit
    [[ -n $word ]] || exit
fi

suggestions=()
while IFS= read -r line; do
    case $line in
    '& '*)
        remaining=${line#*: }
        while [[ $remaining == *', '* ]]; do
            suggestions+=("${remaining%%, *}")
            remaining=${remaining#*, }
        done
        suggestions+=("$remaining")
        ;;
    '*')
        exit 0
        ;;
    esac
done < <(printf '%s\n' "$word" | aspell -a --sug-mode=bad-spellers)

if command -v tmux >/dev/null 2>&1; then
    printf '%s\n' "${suggestions[@]}" |
        fzf --prompt="selection > " --popup center,20%,50% |
        xclip -selection clipboard -rmlastnl
else
    printf '%s\n' "${suggestions[@]}" |
        fzf --prompt="selection > " |
        xclip -selection clipboard -rmlastnl
fi
