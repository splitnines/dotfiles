#!/usr/bin/env bash

require_cmd() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || {
            echo "required command not found: $cmd"
            exit 1
        }
    done
}

require_cmd aspell fzf xclip

(
    word=${1:-}
    if [[ -z $word ]]; then
        read -r -p 'Lookup: ' word </dev/tty || exit
        [[ -n $word ]] || exit
    fi

    choice=$(
        printf '%s\n' "$word" | aspell -a |
            while IFS= read -r line; do
                case $line in
                '& '* | '? '*)
                    suggestions=${line#*: }
                    while [[ $suggestions == *', '* ]]; do
                        printf '%s\n' "${suggestions%%, *}"
                        suggestions=${suggestions#*, }
                    done
                    printf '%s\n' "$suggestions"
                    ;;
                esac
            done | (
            if command -v tmux >/dev/null 2>&1; then
                fzf --prompt="Selection > " --popup
            else
                fzf --prompt="Selection > "
            fi
        )
    ) || exit

    [[ -n $choice ]] || exit
    printf '%s' "$choice" | xclip -selection clipboard
)
