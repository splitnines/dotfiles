#!/usr/bin/env bash

if [[ "$#" -lt 1 ]]; then
    echo -e "error: project name not specified\n"
    echo -e "\tusage: cinit <project name>\n"
    exit 1
fi

PROJECT_NAME="$1"

makefile() {
    if [[ ! -f "$PROJECT_NAME/Makefile" ]]; then
        {
            printf 'CC = gcc\n'
            printf 'CFLAGS = -Wall -Wextra\n'
            printf 'LDFLAGS =\n'
            printf 'LDLIBS =\n'
            printf '\n'
            printf 'NAME = %s\n' "$PROJECT_NAME"
            printf 'SRC = src\n'
            printf 'OBJ = obj\n'
            printf 'BIN = bin\n'
            printf '\n'
            printf 'EXEC = %s\n' "\$(BIN)/\$(NAME)"
            printf 'BINSRC = %s\n' "\$(wildcard \$(SRC)/*.c)"
            printf 'LIBSRC = %s\n' "\$(wildcard \$(SRC)/*/*.c)"
            printf 'ALLSRC = %s\n' "\$(BINSRC) \$(LIBSRC)"
            printf '\n'
            printf 'LIBOBJ = %s\n' "\$(patsubst \$(SRC)/%.c,\$(OBJ)/%.o,\$(LIBSRC))"
            printf 'BINS = %s\n' "\$(patsubst \$(SRC)/%.c,\$(BIN)/%,\$(BINSRC))"
            printf 'DEPS = %s\n' "\$(patsubst \$(SRC)/%.c,\$(OBJ)/%.d,\$(ALLSRC))"
            printf "\n"
            printf 'PREFIX ?= /usr/local\n'
            printf '%s\n' "BINDIR ?= \$(PREFIX)/bin"
            printf '\n'
            printf 'all: %s\n' "\$(EXEC)"
            printf '\n'
            printf '%s\n' "\$(EXEC): \$(OBJ)/main.o \$(LIBOBJ)"
            printf '\t%s\n' "@mkdir -p \$(@D)"
            printf '\t%s\n' "\$(CC) \$(LDFLAGS) \$^ \$(LDLIBS) -o \$@"
            printf '\n'
            printf '%s\n' "\$(OBJ)/%.o: \$(SRC)/%.c"
            printf '\t%s\n' "@mkdir -p \$(@D)"
            printf '\t%s\n' "\$(CC) \$(CFLAGS) \$< -c -MMD -o \$@"
            printf '\n'
            printf '%s\n' "run: \$(EXEC)"
            printf '\t%s\n' "@\$(EXEC)"
            printf '\n'
            printf 'watch:\n'
            printf '\t%s\n' "@find \$(SRC) -type f | entr -c make --no-print-directory run"
            printf '\n'
            printf '%s\n' "install: \$(EXEC)"
            printf '\t%s\n' "install -d \"\$(BINDIR)\""
            printf '\t%s\n' "install -m 755 \"\$(EXEC)\" \"\$(BINDIR)/\$(NAME)\""
            printf '\n'
            printf 'clean:\n'
            printf '\t%s\n' "@rm -rf \$(BIN) \$(OBJ)"
            printf '\n'
            printf '%s\n' "-include \$(DEPS)"
            printf '\n'
            printf '.PHONY: all run clean watch install\n'
        } >"$PROJECT_NAME/Makefile"
    fi
}

main_c() {
    if [[ ! -f "$PROJECT_NAME/src/main.c" ]]; then
        {
            printf '#include <stdio.h>\n'
            printf '\n'
            printf 'int main() {\n'
            printf '    printf("Hello, fuckers!\\n");\n'
            printf '\n'
            printf '    return 0;\n'
            printf '}\n'
        } >"$PROJECT_NAME/src/main.c"
    fi
}

dir_structure() {
    mkdir -p "$PROJECT_NAME"/src
}

create_git() {
    touch "$PROJECT_NAME/.gitignore"
    printf 'build/\n' >"$PROJECT_NAME/.gitignore"
    git -C "$PROJECT_NAME" init
}

if [[ ! -d "$PROJECT_NAME" ]]; then
    printf '\033[32mCreating\033[0m C project "%s"\n' "$PROJECT_NAME"

    dir_structure
    create_git
    main_c
    makefile "$PROJECT_NAME"
else
    echo -e "project name \"$PROJECT_NAME\" already exists"
fi
