#!/usr/bin/env bash

mkdir -p "$HOME/.cache"
PIDFILE="$HOME/.cache/autotiling.pid"

if [ -f "$PIDFILE" ]; then
    OLD_PID="$(cat "$PIDFILE")"
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        kill "$OLD_PID"
    fi
fi

# Resolve this launcher's real directory so a GNU Stow symlink still finds
# the virtual environment created beside the source files.
SCRIPT_PATH="$(readlink -f -- "$0")" || exit 1
SCRIPT_DIR="$(dirname -- "$SCRIPT_PATH")"
cd "$SCRIPT_DIR" || exit 1

PYTHON_BIN="$SCRIPT_DIR/.venv/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
    PYTHON_BIN="$(command -v python3 || command -v python)"
fi

if [ -z "$PYTHON_BIN" ]; then
    echo "Error: python3/python not found in PATH" >&2
    exit 1
fi

"$PYTHON_BIN" autotiling.py &

echo $! > "$PIDFILE"
