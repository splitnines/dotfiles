set realname = "Rickey Ingrassia"
set from = "rickey.ingrassia@gmail.com"
set status_format = "[rickey.ingrassia] -%r-NeoMutt: %D [Msgs:%<M?%M/>%m%<n? New:%n>%<o? Old:%o>%<d? Del:%d>%<F? Flag:%F>%<t? Tag:%t>%<p? Post:%p>%<b? Inc:%b>%<l? %l>]---(%<T?%T/>%s/%S)-%>-(%P)---"
set use_from = yes
set envelope_from = yes

set folder = "imaps://rickey.ingrassia@gmail.com@imap.gmail.com:993/"
set spoolfile = "+INBOX"

set imap_user = "rickey.ingrassia@gmail.com"
set imap_pass = "`pass show neomutt/rickey.ingrassia | head -n 1`"

set smtp_url = "smtps://rickey.ingrassia@gmail.com@smtp.gmail.com:465/"
set smtp_pass = "`pass show neomutt/rickey.ingrassia | head -n 1`"

# Clear OAuth-only settings when switching from the LCSC account
unset imap_authenticators
unset smtp_authenticators
unset imap_oauth_refresh_command
unset smtp_oauth_refresh_command

set postponed = "+[Gmail]/Drafts"
set trash = "+[Gmail]/Trash"

unset record

# Replace the previous account's sidebar folders with this account's folders
unmailboxes *
mailboxes +INBOX
mailboxes "+[Gmail]/All Mail"
mailboxes "+[Gmail]/Drafts"
mailboxes "+[Gmail]/Sent Mail"
mailboxes "+[Gmail]/Spam"
mailboxes "+[Gmail]/Trash"
mailboxes "+AWS"

set signature = "~/.config/neomutt/signature-rickey.ingrassia"

