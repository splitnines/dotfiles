# General TLS settings
set ssl_force_tls = yes
set ssl_starttls = yes
set ssl_ca_certificates_file = "/etc/ssl/certs/ca-certificates.crt"

# Cache
set header_cache = "~/.cache/neomutt/headers"
set message_cachedir = "~/.cache/neomutt/bodies"

# Editing and display
set editor = "nvim"
set charset = "utf-8"
set sort = "reverse-date"
# Attachment indicator; %X may add MIME-inspection overhead on IMAP folders
# set index_format = "%4C  %Z  %<X?a& >  %{%b %d %y}  %-35.35n  %s"
set index_format = "%4C  %Z  %{%b %d %y}  %-35.35n  %s"

# Start with splitnines account
source ~/.config/neomutt/accounts/splitnines

# Automatically select the correct identity when entering a mailbox
folder-hook 'imaps://splitnines@gmail\.com@imap\.gmail\.com' \
  'source ~/.config/neomutt/accounts/splitnines'

folder-hook 'imaps://rickey\.ingrassia@gmail\.com@imap\.gmail\.com' \
  'source ~/.config/neomutt/accounts/rickey.ingrassia'

folder-hook 'imaps://uspsa@lindencsc\.com@imap\.gmail\.com' \
  'source ~/.config/neomutt/accounts/lcsc'


# Load account-switching bindings only once per NeoMutt process.
# This avoids duplicate-prefix warnings when this file is re-sourced.
ifndef my_account_bindings_loaded 'source ~/.config/neomutt/account-bindings'
set my_account_bindings_loaded = yes

# Pager
set pager = ""
set wrap = 0
set smart_wrap = yes
set pager_stop = yes

# Vim-style movement inside the message pager
bind pager j next-line
bind pager k previous-line
bind pager J next-undeleted
bind pager K previous-undeleted
macro pager d "<delete-message><exit>" "Delete message and return to index"

bind index,pager G imap-fetch-mail
bind index,pager <F8> purge-message

# Poll less aggressively; IMAP IDLE still handles the current mailbox
set mail_check = 60
set timeout = 60
set imap_keep_alive = 300
set imap_idle = yes

# Folder sidebar
set sidebar_visible = yes
set sidebar_width = 30
set sidebar_short_path = yes
set sidebar_folder_indent = yes
set sidebar_indent_string = "  "
set sidebar_format = "%B%* %<N?%N>"

# Sidebar navigation
bind index,pager \CP sidebar-prev
bind index,pager \CN sidebar-next
bind index,pager \CO sidebar-open
bind index,pager B sidebar-toggle-visible

# Colors
source ~/.config/neomutt/colors
